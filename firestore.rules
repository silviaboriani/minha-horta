rules_version = '2';

// Minha Horta — quem pode ler e gravar cada horta compartilhada (hortas/{id}).
// Publicadas no console do Firebase (Firestore → Regras). Mantenha esta cópia igual à de lá.
service cloud.firestore {
  match /databases/{database}/documents {
    match /hortas/{id} {
      function logada() { return request.auth != null && request.auth.token.email_verified == true; }
      function eu() { return request.auth.token.email.lower(); }
      function pessoa() { return logada() && eu() in resource.data.emails; }
      function camposOk() {
        return request.resource.data.keys().hasOnly(['nome', 'dono', 'donoEmail', 'emails', 'estado', 'versao', 'atualizadoEm', 'por',
                                                'convite', 'conviteAte', 'ultimoCodigo'])
          && request.resource.data.estado is string
          && request.resource.data.estado.size() < 900000
          && request.resource.data.emails is list
          && request.resource.data.emails.size() <= 50;
      }
      // o link de convite (código e validade) só a dona muda
      function conviteIgual() {
        return request.resource.data.get('convite', null) == resource.data.get('convite', null)
          && request.resource.data.get('conviteAte', null) == resource.data.get('conviteAte', null);
      }

      // ler (e listar as compartilhadas comigo): só quem está na lista de e-mails
      allow get, list: if pessoa();

      // criar: a pessoa logada é a dona e está na lista; começa na versão 1
      allow create: if logada()
        && request.resource.data.dono == request.auth.uid
        && request.resource.data.donoEmail == eu()
        && request.resource.data.emails == [eu()]
        && request.resource.data.versao == 1
        && request.resource.data.por == eu()
        && camposOk();

      // mudar: quem está na lista; a dona não muda e continua na lista; a lista de pessoas só a dona muda
      // (qualquer um pode se tirar); "por" é quem grava; cada gravação aumenta a versão em 1
      allow update: if pessoa()
        && camposOk()
        && request.resource.data.dono == resource.data.dono
        && request.resource.data.donoEmail == resource.data.donoEmail
        && resource.data.donoEmail in request.resource.data.emails
        && request.resource.data.versao == resource.data.versao + 1
        && (request.resource.data.por == resource.data.por || request.resource.data.por == eu())
        && (conviteIgual() || resource.data.dono == request.auth.uid)
        && request.resource.data.get('ultimoCodigo', null) == resource.data.get('ultimoCodigo', null)
        && (request.resource.data.emails == resource.data.emails
            || resource.data.dono == request.auth.uid
            || request.resource.data.emails == resource.data.emails.removeAll([eu()]));

      // entrar com o link de convite: quem ainda não está na lista se põe nela (só ela mesma),
      // com o código certo e antes de o link vencer; não mexe em mais nada
      allow update: if logada()
        && !(eu() in resource.data.emails)
        && resource.data.get('convite', null) is string
        && request.resource.data.ultimoCodigo == resource.data.convite
        && request.time.toMillis() < resource.data.conviteAte
        && request.resource.data.diff(resource.data).affectedKeys().hasOnly(['emails', 'ultimoCodigo'])
        && request.resource.data.emails == resource.data.emails.concat([eu()])
        && resource.data.emails.size() < 50;

      // apagar (parar de compartilhar): só a dona
      allow delete: if logada() && resource.data.dono == request.auth.uid;
    }
  }
}
